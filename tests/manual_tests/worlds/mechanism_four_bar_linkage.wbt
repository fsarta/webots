#VRML_SIM R2025a utf8

EXTERNPROTO "webots://projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "webots://projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  gravity 0 0 0
  basicTimeStep 16
}
Viewpoint {
  orientation 0.85 0.15 0.5 0.8
  position 0.2 0.75 0.85
}
TexturedBackground {
}
TexturedBackgroundLight {
}
# Planar four-bar linkage with a closed kinematic chain:
#   four_bar(BASE) -J0-> CRANK -J1-> COUPLER -(J3 loop)-> ROCKER -J2-> four_bar(BASE)
# J3 closes the loop through a SolidReference endpoint: in the Mechanism Editor
# it appears as a green diamond and the mobility report shows 1 DOF (planar).
DEF FOUR_BAR Robot {
  name "four_bar"
  controller "<none>"
  children [
    DEF J0 HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0
      }
      device [
        RotationalMotor {
          name "crank_motor"
        }
        PositionSensor {
          name "crank_sensor"
        }
      ]
      endPoint DEF CRANK Solid {
        translation 0.025 0 0.0433
        rotation 0 1 0 -1.0472
        name "CRANK"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.8 0.25 0.2
            }
            geometry DEF CRANK_BOX Box {
              size 0.1 0.02 0.02
            }
          }
          DEF J1 HingeJoint {
            jointParameters HingeJointParameters {
              axis 0 1 0
              anchor 0.05 0 0
            }
            endPoint DEF COUPLER Solid {
              translation 0.1956 0 -0.0971
              rotation 0 1 0 0.588
              name "COUPLER"
              children [
                Shape {
                  appearance PBRAppearance {
                    baseColor 0.2 0.5 0.8
                  }
                  geometry DEF COUPLER_BOX Box {
                    size 0.35 0.02 0.02
                  }
                }
                DEF J3 HingeJoint {
                  jointParameters HingeJointParameters {
                    axis 0 1 0
                    anchor 0.175 0 0
                  }
                  endPoint SolidReference {
                    solidName "ROCKER"
                  }
                }
              ]
              boundingObject USE COUPLER_BOX
              physics Physics {
                mass 0.1
              }
            }
          }
        ]
        boundingObject USE CRANK_BOX
        physics Physics {
          mass 0.1
        }
      }
    }
    DEF J2 HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.3 0 0
      }
      endPoint DEF ROCKER Solid {
        translation 0.33185 0 0.12085
        rotation 0 1 0 -1.312
        name "ROCKER"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.2 0.7 0.3
            }
            geometry DEF ROCKER_BOX Box {
              size 0.25 0.02 0.02
            }
          }
        ]
        boundingObject USE ROCKER_BOX
        physics Physics {
          mass 0.1
        }
      }
    }
    # base plate (static: the Robot itself has no Physics)
    Shape {
      appearance PBRAppearance {
        baseColor 0.4 0.4 0.45
      }
      geometry Box {
        size 0.45 0.01 0.3
      }
      translation 0.2 0 0
    }
  ]
}
